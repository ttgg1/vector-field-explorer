+                rect.width(),
+                rect.height(),
+            );
+        }
+        if now.duration_since(state.start).as_secs_f32() > state.seconds {
+            log::info!("BENCH_END,{},{}", state.label, state.frames);
+            ctx.send_viewport_cmd(eframe::egui::ViewportCommand::Close);
+        }
+    }
+
+    /// Apply the benchmark scene from env vars after persistence restore.
+    pub fn configure(state: &mut State, layout: &mut crate::ui::layout::LayoutState) {
+        if !enabled() {
