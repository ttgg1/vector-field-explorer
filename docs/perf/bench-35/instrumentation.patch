+            .unwrap_or(if mode_3d { 16 } else { 24 });
+        state.set_density(density);
+        state.set_arrow_scale(1.0);
+        state.set_arrow_style(crate::arrow_style::ArrowStyle::Cone);
+        state.set_arrow_style_2d(crate::arrow_style::ArrowStyle2D::Flat);
+        state.set_colormap(crate::colormap::Colormap::Viridis);
+        state.set_auto_fit(true);
+        state.set_plane_enabled(false);
+        state.set_arrows(env("VFE_BENCH_ARROWS").is_none_or(|on| on == "1"));
+        state.set_streamlines(env("VFE_BENCH_STREAMLINES").is_some_and(|on| on == "1"));
+        state.set_particles(env("VFE_BENCH_PARTICLES").is_some_and(|on| on == "1"));
+        state.set_particle_size(1.0);
+        state.set_particle_count(
+            env("VFE_BENCH_COUNT").and_then(|v| v.parse().ok()).unwrap_or(0),
+        );
+        let mut appearance = crate::particles::ParticleAppearance::default();
+        if let Some(trail) = env("VFE_BENCH_TRAIL").and_then(|v| v.parse().ok()) {
+            appearance.trail_len = trail;
+        }
+        state.set_particle_appearance(appearance);
+    }
+}
