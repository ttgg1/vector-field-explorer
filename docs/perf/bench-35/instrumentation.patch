+    use crate::viewmodel::State;
+
+    pub struct BenchState {
+        pub label: String,
+        pub seconds: f32,
+        pub start: Instant,
+        pub last_start: Option<Instant>,
+        pub frames: u64,
+        pub sim_us: f64,
+        pub advect_us: f64,
+        pub dot_us: f64,
+        pub trail_us: f64,
+        pub viewport_us: f64,
+        pub combined_us: f64,
+        pub trailsort_us: f64,
+        pub particles: usize,
+        pub dots: usize,
+        pub trails: usize,
+        pub arrow_count: usize,
+    }
+
+    static BENCH: Mutex<Option<BenchState>> = Mutex::new(None);
+
+    pub fn enabled() -> bool {
+        std::env::var_os("VFE_BENCH_SECONDS").is_some()
+    }
+
+    pub fn label() -> String {
+        std::env::var("VFE_BENCH_LABEL").unwrap_or_else(|_| "unlabelled".to_string())
+    }
+
+    /// Frames completed so far; used to run the GPU bench once trails fill.
+    pub fn frame_index() -> u64 {
+        BENCH.lock().ok().and_then(|guard| guard.as_ref().map(|state| state.frames)).unwrap_or(0)
+    }
+
+    pub fn begin() {
+        if !enabled() {
+            return;
+        }
+        let mut guard = BENCH.lock().unwrap();
+        if guard.is_none() {
+            let seconds = std::env::var("VFE_BENCH_SECONDS")
+                .ok()
+                .and_then(|value| value.parse().ok())
+                .unwrap_or(25.0);
+            *guard = Some(BenchState {
+                label: label(),
+                seconds,
+                start: Instant::now(),
+                last_start: None,
+                frames: 0,
+                sim_us: 0.0,
+                advect_us: 0.0,
+                dot_us: 0.0,
+                trail_us: 0.0,
+                viewport_us: 0.0,
+                combined_us: 0.0,
+                trailsort_us: 0.0,
+                particles: 0,
+                dots: 0,
+                trails: 0,
+                arrow_count: 0,
+            });
+        }
+        if let Some(state) = guard.as_mut() {
+            state.sim_us = 0.0;
+            state.advect_us = 0.0;
+            state.dot_us = 0.0;
+            state.trail_us = 0.0;
+            state.viewport_us = 0.0;
+            state.combined_us = 0.0;
+            state.trailsort_us = 0.0;
+        }
+    }
+
+    pub fn add_sim(us: f64) {
+        if let Ok(mut guard) = BENCH.lock()
+            && let Some(state) = guard.as_mut()
+        {
+            state.sim_us += us;
+        }
+    }
+    pub fn add_advect(us: f64) {
+        if let Ok(mut guard) = BENCH.lock()
+            && let Some(state) = guard.as_mut()
+        {
+            state.advect_us += us;
+        }
+    }
+    pub fn add_dot(us: f64) {
+        if let Ok(mut guard) = BENCH.lock()
+            && let Some(state) = guard.as_mut()
+        {
+            state.dot_us += us;
+        }
+    }
+    pub fn add_trail(us: f64) {
+        if let Ok(mut guard) = BENCH.lock()
