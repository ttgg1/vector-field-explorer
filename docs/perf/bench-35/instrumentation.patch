+        {
+            state.particles = particles;
+            state.dots = dots;
+            state.trails = trails;
+            state.arrow_count = arrows;
+        }
+    }
+
+    /// Log one CSV frame line and close the window once the run is over.
+    pub fn end(ctx: &eframe::egui::Context) {
+        if !enabled() {
+            return;
+        }
+        let now = Instant::now();
+        let mut guard = BENCH.lock().unwrap();
+        let Some(state) = guard.as_mut() else { return };
+        let interval_us = state
+            .last_start
+            .map_or(0.0, |last| now.duration_since(last).as_secs_f64() * 1e6);
+        state.last_start = Some(now);
+        state.frames += 1;
+        // Discard the first 120 frames (~2 s) from the analysis; still log them
+        // so the report can show startup separately.
+        let line = format!(
+            "BENCH,{},{},{:.0},{:.0},{:.0},{:.0},{:.0},{:.0},{:.0},{:.0},{},{},{},{}",
+            state.label,
+            state.frames,
+            interval_us,
+            state.sim_us,
+            state.advect_us,
+            state.dot_us,
+            state.trail_us,
+            state.viewport_us,
+            state.combined_us,
+            state.trailsort_us,
+            state.particles,
+            state.dots,
+            state.trails,
+            state.arrow_count,
+        );
+        log::info!("{line}");
+        // Benchmarks must run continuously even when nothing consumes a clock.
+        ctx.request_repaint();
