{
  "name": "Vector Field Explorer",
  "short_name": "Vector Field",
  "description": "A formula-driven vector-field explorer for 2D and 3D fields.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101a26",
  "theme_color": "#101a26",
  "icons": [
